    if result.returncode != 0:
        fail("Django system check failed.")
        print(result.stdout)
        print(result.stderr)
        return False

    passed("Django system check passed.")
    return True


def runtime_duplicate_audit() -> tuple[bool, int]:
    banner("DJANGO RUNTIME DUPLICATE ROUTE AUDIT")

    script = r'''
from django.urls import get_resolver

resolver = get_resolver()

routes = {}

def walk(patterns, prefix=""):
    for pattern in patterns:
        route = prefix + str(getattr(pattern, "pattern", ""))

        children = getattr(pattern, "url_patterns", None)

        if children:
            walk(children, route)
            continue

        if "api/patient-management/" not in route:
            continue

        callback = getattr(pattern, "callback", None)

        module = getattr(callback, "__module__", "")
        name = getattr(callback, "__name__", "")

        key = route

        routes.setdefault(key, []).append(
            (module, name)
        )

walk(resolver.url_patterns)

duplicates = {
    route: callbacks
    for route, callbacks in routes.items()
    if len(callbacks) > 1
}

for route in sorted(duplicates):
    print(
        "DUPLICATE|"
        + route
        + "|"
        + str(len(duplicates[route]))
    )

    for module, name in duplicates[route]:
        print(
            "CALLBACK|"
            + module
            + "|"
            + name
        )

print("TOTAL_DUPLICATES|" + str(len(duplicates)))
'''

    result = subprocess.run(
        [
            sys.executable,
            "-B",
            "manage.py",
            "shell",
            "-c",
            script,
        ],
        cwd=BACKEND_ROOT,
        capture_output=True,
        text=True,
    )

    output = result.stdout or ""
    error = result.stderr or ""

    if result.returncode != 0:
        fail("Django runtime URL audit could not initialize.")
        print(output)
        print(error)
        return False, -1

    total = 0

    for line in output.splitlines():
        if line.startswith("DUPLICATE|"):
            print(line)

        elif line.startswith("CALLBACK|"):
            print(line)

        elif line.startswith("TOTAL_DUPLICATES|"):
            try:
                total = int(line.split("|", 1)[1])
            except ValueError:
                total = -1

    if total == 0:
        passed("No duplicate Patient Management runtime routes discovered.")
        return True, 0

    gap(f"Duplicate Patient Management runtime routes: {total}")
    return False, total


def runtime_canonical_surface_audit() -> bool:
    banner("CANONICAL RUNTIME SURFACE AUDIT")

    script = r'''
from django.urls import resolve

checks = [
    (
        "/api/patient-management/profile/",
        "apps.patient_management.profile.api.views.profile",
    ),
    (
        "/api/patient-management/patients/",
        None,
    ),
    (
        "/api/patient-management/identifiers/",
        None,
    ),
    (
        "/api/patient-management/family_members/",
        None,
    ),
    (
        "/api/patient-management/contacts/",
        None,
    ),
    (
        "/api/patient-management/addresses/",
        None,
    ),
]

for route, expected_module in checks:
    try:
        match = resolve(route)
        callback = match.func
        module = getattr(callback, "__module__", "")
        name = getattr(callback, "__name__", "")

        if expected_module and module != expected_module:
            print(
                "GAP|"
                + route
                + "|"
                + module
                + "|"
                + name
            )
        else:
            print(
                "PASS|"
                + route
                + "|"
                + module
                + "|"
                + name
            )
    except Exception as exc:
        print(
            "GAP|"
            + route
            + "|UNRESOLVED|"
            + exc.__class__.__name__
        )
'''

    result = subprocess.run(
        [
            sys.executable,
            "-B",
            "manage.py",
            "shell",
            "-c",
            script,
        ],
        cwd=BACKEND_ROOT,
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        fail("Canonical runtime surface audit failed to execute.")
        print(result.stdout or "")
        print(result.stderr or "")
        return False

    ok = True

    for line in (result.stdout or "").splitlines():
        if line.startswith("PASS|"):
            parts = line.split("|")
            route = parts[1]
            module = parts[2]
            name = parts[3]
            passed(f"{route} -> {module}.{name}")

        elif line.startswith("GAP|"):
            print(line)
            ok = False

    return ok


def audit_only() -> int:
    banner(
        "DATAVIONOS PATIENT MANAGEMENT CANONICAL URLCONF REPAIR"
    )

    print(f"VERSION      : {VERSION}")
    print(f"BACKEND ROOT : {BACKEND_ROOT}")
    print(f"PATIENT ROOT : {PATIENT_ROOT}")
    print("MODE         : READ-ONLY / NO SOURCE CHANGES")

    banner("SAFETY BOUNDARIES")

    print("DATABASE CHANGES       : NONE")
    print("MIGRATIONS             : NONE")
    print("MODEL CHANGES          : NONE")
    print("SERIALIZER CHANGES     : NONE")
    print("VIEW CHANGES           : NONE")
    print("SERVICE CHANGES        : NONE")
    print("WORKFLOW CHANGES       : NONE")
    print("PROFILE ROUTE          : UNTOUCHED")
    print("PROFILE CODE           : UNTOUCHED")
    print("FAMILY MEMBERS LOGIC   : UNTOUCHED")
    print("FAMILY MEMBERS VIEWS   : UNTOUCHED")

    if not validate_structure():
        return 1

    banner("PYTHON SOURCE VALIDATION")

    for path in (
        CONFIG_URLS,
        PATIENT_URLS,
        PATIENT_API_URLS,
    ):
        if not compile_file(path):
            return 1

    banner("CONFIG URLCONF AUDIT")

    if not audit_config_urlconf():
        return 1

    if not validate_canonical_api_source():
        return 1

    if not run_django_check():
        return 1

    runtime_ok, duplicate_count = runtime_duplicate_audit()

    if not runtime_ok:
        return 1

    if not runtime_canonical_surface_audit():
        return 1

    banner("AUDIT RESULT")

    passed("Patient Management canonical URL surface is healthy.")
    passed(f"Runtime duplicate routes: {duplicate_count}")
    print("STATUS: PASS")

    return 0


def apply() -> int:
    banner(
        "DATAVIONOS PATIENT MANAGEMENT CANONICAL URLCONF REPAIR"
    )

    print(f"VERSION      : {VERSION}")
    print(f"BACKEND ROOT : {BACKEND_ROOT}")
    print(f"PATIENT ROOT : {PATIENT_ROOT}")
    print(f"BACKUP       : {BACKUP_ROOT}")
    print("MODE         : APPLY")

    banner("SAFETY BOUNDARIES")

    print("DATABASE CHANGES       : NONE")
    print("MIGRATIONS             : NONE")
    print("MODEL CHANGES          : NONE")
    print("SERIALIZER CHANGES     : NONE")
    print("VIEW CHANGES           : NONE")
    print("SERVICE CHANGES        : NONE")
    print("WORKFLOW CHANGES       : NONE")
    print("PROFILE ROUTE          : UNTOUCHED")
    print("PROFILE CODE           : UNTOUCHED")
    print("FAMILY MEMBERS LOGIC   : UNTOUCHED")
    print("FAMILY MEMBERS VIEWS   : UNTOUCHED")

    if not validate_structure():
        return 1

    banner("PRE-REPAIR VALIDATION")

    if not compile_file(CONFIG_URLS):
        return 1

    if not compile_file(PATIENT_URLS):
        return 1

    if not compile_file(PATIENT_API_URLS):
        return 1

    banner("REPAIR")

    try:
        apply_config_repair()
        apply_canonical_api_urlconf()
    except Exception as exc:
        fail(f"Repair failed before completion: {exc}")
        return 1

    banner("POST-REPAIR PYTHON VALIDATION")

    if not compile_file(CONFIG_URLS):
        return 1

    if not compile_file(PATIENT_URLS):
        return 1

    if not compile_file(PATIENT_API_URLS):
        return 1

    banner("POST-REPAIR CANONICAL URLCONF AUDIT")

    if not audit_config_urlconf():
        return 1

    if not validate_canonical_api_source():
        return 1

    if not run_django_check():
        return 1

    runtime_ok, duplicate_count = runtime_duplicate_audit()

    if not runtime_ok:
        banner("REPAIR RESULT")
        gap(
            "Duplicate runtime routes remain. "
            "No model, view, service, or workflow changes were made."
        )
        return 1

    if not runtime_canonical_surface_audit():
        banner("REPAIR RESULT")
        gap("Canonical Patient Management runtime surface is incomplete.")
        return 1

    banner("FINAL RESULT")

    passed("Canonical config/urls.py ownership: PASS")
    passed("Canonical Patient Management API URLConf: PASS")
    passed("Django system check: PASS")
    passed("Runtime duplicate routes: 0")
    passed("Canonical runtime surface: PASS")

    print()
    print("STATUS: PASS")
    print()
    print(
        "Patient Management now has one upstream runtime registration:"
    )
    print(
        "  /api/patient-management/"
        " -> apps.patient_management.urls"
    )
    print()
    print(
        "All Patient Management child routes are owned by:"
    )
    print(
        "  apps.patient_management.api.urls"
    )

    return 0



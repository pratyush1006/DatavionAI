def is_patient_direct_path_call(node: ast.Call) -> bool:
    if not node.args:
        return False

    first = node.args[0]

    if not isinstance(first, ast.Constant):
        return False

    if not isinstance(first.value, str):
        return False

    route = first.value.strip().strip("/")

    if route == "api/patient-management":
        return False

    for forbidden in FORBIDDEN_CONFIG_PREFIXES:
        if route.startswith(forbidden.strip("/")):
            return True

    return False


def remove_direct_patient_routes_from_config(source: str) -> str:
    tree = ast.parse(source, filename=str(CONFIG_URLS))

    lines = source.splitlines(keepends=True)
    removals: list[tuple[int, int]] = []

    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            if not isinstance(node.func, ast.Name):
                continue

            if node.func.id != "path":
                continue

            if not is_patient_direct_path_call(node):
                continue

            start = node.lineno - 1
            end = node.end_lineno

            removals.append((start, end))

    if not removals:
        return source

    for start, end in sorted(removals, reverse=True):
        del lines[start:end]

    result = "".join(lines)

    # Remove accidental excessive blank lines.
    result = re.sub(r"\n{4,}", "\n\n\n", result)

    return result


def ensure_canonical_config_registration(source: str) -> str:
    tree = ast.parse(source, filename=str(CONFIG_URLS))

    canonical_count = 0

    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue

        if not isinstance(node.func, ast.Name):
            continue

        if node.func.id != "path":
            continue

        if not node.args:
            continue

        first = node.args[0]

        if not (
            isinstance(first, ast.Constant)
            and first.value == "api/patient-management/"
        ):
            continue

        canonical_count += 1

    if canonical_count == 1:
        return source

    if canonical_count > 1:
        raise RuntimeError(
            "Multiple canonical api/patient-management/ registrations "
            "were found in config/urls.py."
        )

    raise RuntimeError(
        "Canonical api/patient-management/ registration is missing "
        "from config/urls.py. The installer will not invent its location."
    )


def audit_config_urlconf() -> bool:
    banner("CONFIG URLCONF AUDIT")

    source = CONFIG_URLS.read_text(encoding="utf-8")

    try:
        source = ensure_canonical_config_registration(source)
    except RuntimeError as exc:
        fail(str(exc))
        return False

    tree = ast.parse(source, filename=str(CONFIG_URLS))

    direct_routes: list[str] = []

    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            if isinstance(node.func, ast.Name) and node.func.id == "path":
                if node.args and isinstance(node.args[0], ast.Constant):
                    value = node.args[0].value

                    if (
                        isinstance(value, str)
                        and value.startswith("api/patient-management/")
                        and value != "api/patient-management/"
                    ):
                        direct_routes.append(value)

    if direct_routes:
        for route in direct_routes:
            gap(f"Direct Patient Management registration: {route}")
        return False

    passed(
        "config/urls.py contains exactly one canonical "
        "api/patient-management/ registration."
    )

    return True


def apply_config_repair() -> None:
    banner("APPLYING CONFIG URLCONF CANONICALIZATION")

    source = CONFIG_URLS.read_text(encoding="utf-8")

    repaired = remove_direct_patient_routes_from_config(source)

    if repaired == source:
        passed("No direct duplicate Patient Management registration found.")
        return

    # Validate the resulting source before writing.
    ast.parse(repaired, filename=str(CONFIG_URLS))

    backup_file(CONFIG_URLS)

    CONFIG_URLS.write_text(
        repaired,
        encoding="utf-8",
    )

    passed(
        "Removed direct Patient Management child-route registrations "
        "from config/urls.py."
    )



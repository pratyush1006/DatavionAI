    if "--audit-only" in sys.argv:
        return audit_only()

    if "--apply" in sys.argv:
        return apply()

    print(
        "Usage:\n"
        "  python -B "
        "installer_datavionos_patient_management_canonical_urlconf_repair.py "
        "--audit-only\n\n"
        "  python -B "
        "installer_datavionos_patient_management_canonical_urlconf_repair.py "
        "--apply"
    )

    return 2



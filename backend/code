        PATIENT_API_URLS,
        CONFIG_URLS,
    ]

    ok = True

    for path in required:
        if path.exists():
            passed(str(path.relative_to(BACKEND_ROOT)))
        else:
            fail(f"Missing: {path}")
            ok = False

    return ok


def parse_python(path: Path) -> ast.AST | None:
    try:
        return ast.parse(
            path.read_text(encoding="utf-8"),
            filename=str(path),
        )
    except SyntaxError as exc:
        fail(f"{path.relative_to(BACKEND_ROOT)} has invalid Python: {exc}")
        return None


def get_call_string(node: ast.AST, keyword: str) -> str | None:
    if not isinstance(node, ast.Call):
        return None

    if not node.args:
        return None

    first = node.args[0]

    if isinstance(first, ast.Constant) and isinstance(first.value, str):
        if keyword == "path":
            return first.value

    return None


def get_include_target(node: ast.AST) -> str | None:
    if not isinstance(node, ast.Call):
        return None

    if not node.args:
        return None

    first = node.args[0]

    if (
        isinstance(first, ast.Call)
        and isinstance(first.func, ast.Name)
        and first.func.id == "include"
        and first.args
        and isinstance(first.args[0], ast.Constant)
        and isinstance(first.args[0].value, str)
    ):
        return first.args[0].value

    return None


def find_urlpatterns_assignment(tree: ast.AST) -> ast.Assign | None:
    for node in ast.walk(tree):
        if isinstance(node, ast.Assign):
            for target in node.targets:
                if isinstance(target, ast.Name) and target.id == "urlpatterns":
                    return node
    return None


def validate_canonical_api_source() -> bool:
    banner("CANONICAL PATIENT MANAGEMENT API URLCONF")

    tree = parse_python(PATIENT_API_URLS)

    if tree is None:
        return False

    assignment = find_urlpatterns_assignment(tree)

    if assignment is None:
        fail("urlpatterns assignment not found.")
        return False

    found: dict[str, str] = {}

    value = assignment.value

    if isinstance(value, (ast.List, ast.Tuple)):
        elements = value.elts
    else:
        elements = []

    for element in elements:
        if isinstance(element, ast.Starred):
            continue

        if not isinstance(element, ast.Call):
            continue

        if not isinstance(element.func, ast.Name):
            continue

        if element.func.id != "path":
            continue

        route = get_call_string(element, "path")
        target = get_include_target(element)

        if route and target:
            found[route] = target

    ok = True

    for route, target in CANONICAL_MODULES.items():
        actual = found.get(route)

        if actual == target:
            passed(f"{route} -> {target}")
        else:
            fail(
                f"Canonical route missing or incorrect: "
                f"{route} -> {target}; actual={actual!r}"
            )
            ok = False

    return ok


